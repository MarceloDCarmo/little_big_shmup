pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	cls(0)
	shipx=60
	shipy=60
	speedx=1
	speedy=1	
end

function _update()
	--controls
	speedx=0
	if btn(⬆️) then
		speedy=-1
	end
	if btn(⬇️) then
		speedy=1
	end
	if btn(⬅️) then
		speedx=-1
	end
	if btn(➡️) then
		speedx=1
	end


	--moves the ship
	shipx+=speedx
	shipy+=speedy

	--check for edges
	speedy=0
 if shipx>=120 then
 	shipx=120
 end
 if shipx<=0 then
 	shipx=0
 end
 if shipy>=120 then
 	shipy=120
 end
 if shipy<=0 then
 	shipy=0
 end
end	

function _draw()
	cls(0)
	spr(1,shipx,shipy)
end
