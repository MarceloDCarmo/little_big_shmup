pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--main
function _init()
	cls(0)
	score=30000
	lives=4
	tlives=4
	mbombs=3
	bombs=3
	
	shipspr=2
	shipx=60
	shipy=60
	shipsx=0
	shipsy=0
	
	flmspr=17
	
	bullets={{x=-1,y=-1}}
	bltspr=5
	bltspd=5
	
	muzzle=0
	
	starx={}
	stary={}
	starcol={}
	scolors={1,13,6}
	for i=1,120 do
		add(starx,flr(rnd(128)))
		add(stary,flr(rnd(128)))
		add(starcol,scolors[flr(rnd(3)+1)])
	end
	
end

function _update()
	--controls
	shipspr=2
	shipsx=0
	shipsy=0
	if btn(⬆️) then
		shipsy=-2
	end
	if btn(⬇️) then
		shipsy=2
	end
	if btn(⬅️) then
		shipspr=1
		shipsx=-2
	end
	if btn(➡️) then
		shipspr=3
		shipsx=2
	end
	if btnp(❎) then
		bltspr=5
		muzzle=4
		sfx(0)
		add(bullets,
			{x=shipx,y=shipy-4}
		)
	end
	if btnp(🅾️) and bombs>0 then
		bltspr=12
		muzzle=4
		sfx(1)
		add(bullets,
			{x=shipx,y=shipy-4}
		)
		bombs-=1
	end


	--moves the ship
	shipx+=shipsx
	shipy+=shipsy
	
	animate_bullets()
	animate_flame()
	animate_muzzle()	
	animate_stars()
	
	--check for edges
	speedy=0
 if shipx>120 then
 	shipx=120
 end
 if shipx<0 then
 	shipx=0
 end
 if shipy>120 then
 	shipy=120
 end
 if shipy<8 then
 	shipy=8
 end
end	

function _draw()
	cls(0)
	
	starfield()
	
	for b in all(bullets) do
		spr(bltspr,b.x,b.y)
	end
		
	spr(shipspr,shipx,shipy)
	spr(flmspr,shipx,shipy+8)
	
	if muzzle>0 then
		circfill(shipx+3,shipy-1,muzzle,7)
		circfill(shipx+4,shipy-1,muzzle,7)
	end
	
	rectfill(0,0,128,7,0)
	print("score:"..score,42,0,6)
	
	--draw lives
	for i=0,tlives-1 do
		if i<=lives then
			spr(11,i*8)
		else
			spr(10,i*8)
		end	
	end
	
	--draw bombs
	for i=0,bombs-1 do
			spr(12,i*-8+120)
	end
	
	if (debug) print(debug)
end
-->8
function starfield()
	for i=1,#starx do
		pset(starx[i],stary[i],starcol[i])
	end
end

function animate_bullets()
	for b in all(bullets) do
		if (b.y<0) del(bullets,b)
		
		b.y-=bltspd
		if bltspr<12 then
			bltspr+=0.75
			if bltspr>9 then
				bltspr=5
			end
		else
			bltspr+=0.25
			if bltspr>15 then
				bltspr=12
			end
		end
	end
end

function animate_flame()
	flmspr+=1
	if flmspr>20 then
		flmspr=17
	end
end

function animate_muzzle()
	if muzzle>0 then
		muzzle-=1
	end
end

function animate_stars()
	for i=1,#stary do
		local spd=2
	
		if starcol[i]==1 then
			spd=0.5
		elseif starcol[i]==13 then
			spd=1
		end	
	
		stary[i]+=spd

		if stary[i]>128 then
			stary[i]=0
		end
	end
end
