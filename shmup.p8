pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--main
function _init()
	cls(0)
	score=30000
	lives=1
	tlives=4
	
	shipspr=2
	shipx=60
	shipy=60
	shipsx=0
	shipsy=0
	
	flmspr=17
	
	bltspr=5
	bltx=-1
	blty=-1
	bltspd=4
	
	muzzle=0
end

function _update()
	--controls
	shipspr=2
	shipsx=0
	shipsy=0
	if btn(⬆️) then
		shipsy=-2
	end
	if btn(⬇️) then
		shipsy=2
	end
	if btn(⬅️) then
		shipspr=1
		shipsx=-2
	end
	if btn(➡️) then
		shipspr=3
		shipsx=2
	end
	if btnp(❎) then
		bltspr=5
		muzzle=4
		sfx(0)
		bltx=shipx
		blty=shipy-4
	end


	--moves the ship
	shipx+=shipsx
	shipy+=shipsy
	
	--animate bullets
	blty-=bltspd
	bltspr+=1
	if bltspr>9 then
		bltspr=5
	end
	
	--animate flame
	flmspr+=1
	if flmspr>20 then
		flmspr=17
	end
	
	--animate muzzle flame
	if muzzle>0 then
		muzzle-=1
	end
	
	--check for edges
	speedy=0
 if shipx>120 then
 	shipx=120
 end
 if shipx<0 then
 	shipx=0
 end
 if shipy>120 then
 	shipy=120
 end
 if shipy<0 then
 	shipy=0
 end
end	

function _draw()
	cls(0)
	
	spr(bltspr,bltx,blty)
	spr(shipspr,shipx,shipy)
	spr(flmspr,shipx,shipy+8)
	
	if muzzle>0 then
		circfill(shipx+3,shipy-1,muzzle,7)
	end
	
	print("score:"..score,42,0,12)
	for i=0,tlives do
		if i<lives then
			spr(11,i*8)
		else
			spr(10,i*8)
		end	
	end
end
