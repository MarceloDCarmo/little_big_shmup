pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
--main
function _init()
	cls(0)
	shipspr=1
	shipx=60
	shipy=60
	shipsx=0
	shipsy=0
	
	
end

function _update()
	--controls
	shipsx=0
	shipsy=0
	if btn(⬆️) then
		shipsy=-2
	end
	if btn(⬇️) then
		shipsy=2
	end
	if btn(⬅️) then
		shipsx=-2
	end
	if btn(➡️) then
		shipsx=2
	end


	--moves the ship
	shipx+=shipsx
	shipy+=shipsy

	--check for edges
	speedy=0
 if shipx>=120 then
 	shipx=120
 end
 if shipx<=0 then
 	shipx=0
 end
 if shipy>=120 then
 	shipy=120
 end
 if shipy<=0 then
 	shipy=0
 end
end	

function _draw()
	cls(0)
	
	if shipsx>0 then
		shipspr=2
	elseif shipsx<0 then
		shipspr=3
	else
		shipspr=1
	end
	
	spr(shipspr,shipx,shipy)
end
